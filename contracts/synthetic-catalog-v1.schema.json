{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-navigator.local/contracts/synthetic-catalog-v1.schema.json",
  "type": "object",
  "required": ["bundle_version", "effective_from", "records"],
  "additionalProperties": false,
  "properties": {
    "bundle_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
    "effective_from": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["source_record_id", "code", "title", "units", "valid_from"],
        "additionalProperties": false,
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "source_url": {"type": "string", "pattern": "^synthetic://", "maxLength": 500},
          "code": {"type": "string", "minLength": 1, "maxLength": 50},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "units": {
            "oneOf": [
              {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
              {"type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?)$"}
            ]
          },
          "valid_from": {"type": "string", "format": "date"},
          "valid_to": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
