# Local synthetic mode only. These values are not production credentials.
POSTGRES_DB=navigator
POSTGRES_USER=navigator_migrator
POSTGRES_PASSWORD=local_migrator_only
APP_DATABASE_URL=postgresql+psycopg://navigator_app:local_app_only@db:5432/navigator
MIGRATION_DATABASE_URL=postgresql+psycopg://navigator_migrator:local_migrator_only@db:5432/navigator
AUTH_MODE=synthetic
LOG_LEVEL=INFO
API_BASE_URL=http://api:8000

# Synthetic tokens resolved server-side; clients do not assert tenant or subject.
# student-a1 -> tenant-a / subject-a1
# student-a2 -> tenant-a / subject-a2
# student-b1 -> tenant-b / subject-b1
# student-b2 -> tenant-b / subject-b2
# admin-a    -> tenant-a administrator (no student subject)
# admin-b    -> tenant-b administrator (no student subject)
